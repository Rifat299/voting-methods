Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "cand", ",", "votes", ",", "preferance", ",", "first", ",", "isValid", 
     ",", "errorMsg"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"cand", "=", 
   RowBox[{
   "Input", "[", 
    "\"\<Type candidate names inside curly braces, separated by \
commas.\\nExample: {p, r, s, t}\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"votes", "=", 
   RowBox[{
   "Input", "[", 
    "\"\<Type the top row of vote counts inside curly braces.\\nExample: {14, \
10, 8, 4, 1}\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"preferance", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Input", "[", 
       RowBox[{"\"\<Type the candidates for Rank \>\"", "<>", 
        RowBox[{"ToString", "[", "i", "]"}], "<>", 
        "\"\< inside curly braces.\\nImportant: You must enter exactly \>\"", 
        "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Length", "[", "votes", "]"}], "]"}], "<>", 
        "\"\< items.\\nExample: {p, s, t, r, s}\>\""}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "cand", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"isValid", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"errorMsg", "=", "\"\<\>\""}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"Transpose", "[", "preferance", "]"}], "]"}], "=!=", 
      RowBox[{"Length", "[", "votes", "]"}]}], ",", 
     RowBox[{
      RowBox[{"isValid", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{
      "errorMsg", "=", 
       "\"\<Error: Dimension Mismatch. The length of your preference rows \
does not match the number of voter groups.\>\""}]}]}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{"isValid", ",", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "preferance", "]"}], "[", 
            RowBox[{"[", "v", "]"}], "]"}], "]"}], "=!=", 
          RowBox[{"Sort", "[", "cand", "]"}]}], ",", 
         RowBox[{
          RowBox[{"isValid", "=", "False"}], ";", "\[IndentingNewLine]", 
          RowBox[{"errorMsg", "=", 
           RowBox[{"\"\<Error: Invalid Preference Table! Voter group \>\"", "<>", 
            RowBox[{"ToString", "[", "v", "]"}], "<>", 
            "\"\< does not contain a valid ranking of the exact candidates \
provided.\>\""}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "1", ",", 
         RowBox[{"Length", "[", "votes", "]"}]}], "}"}]}], "]"}]}], "]"}], 
   ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"isValid", ",", 
    RowBox[{
     RowBox[{"first", "=", 
      RowBox[{"preferance", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Valid preference table built successfully!\>\"", ",", 
        RowBox[{"Darker", "[", "Green", "]"}], ",", "Bold"}], "]"}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", "\"\<Your entered preferance table is:\\n----------\>\"", 
      "]"}], ";", 
     RowBox[{"Print", "[", 
      RowBox[{"TableForm", "[", 
       RowBox[{"Prepend", "[", 
        RowBox[{"preferance", ",", "votes"}], "]"}], "]"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"Style", "[", 
       RowBox[{"errorMsg", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Plurality", " ", "Method"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\\n\\n\\n\\n\\nPlurality Method\\n-------------\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"firstvotes", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"Length", "[", "cand", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"firstvotes", "[", 
     RowBox[{"[", "i", "]"}], "]"}], "=", 
    RowBox[{"Total", "[", 
     RowBox[{"votes", "[", 
      RowBox[{"[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"first", ",", 
          RowBox[{"cand", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "]"}], "]"}], 
     "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", "cand", "]"}]}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Number of gained first count votes= \>\"", ",", "firstvotes", ",", 
    "\"\<\\n\>\"", ",", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Hence winner by Plurality Method is: \>\"", ",", 
         RowBox[{"cand", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"firstvotes", ",", 
              RowBox[{"Max", "[", "firstvotes", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], "}"}], 
       "]"}], ",", 
      RowBox[{"Darker", "[", "Green", "]"}], ",", "Bold"}], "]"}]}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Bodra", " ", "Count", " ", "Method"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\\n\\n\\n\\n\\nBorda count Method\\n-------------\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"Length", "[", "cand", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"points", "[", 
       RowBox[{"[", "j", "]"}], "]"}], "+=", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"votes", "[", 
         RowBox[{"[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"preferance", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"cand", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], "]"}], "]"}], 
        "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Length", "[", "preferance", "]"}], "-", "i", "+", "1"}], 
         ")"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "preferance", "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "1", ",", 
     RowBox[{"Length", "[", "cand", "]"}]}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Number of Obtained points is= \>\"", ",", "points", ",", 
    "\"\<\\n\>\"", ",", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Hence winner by Borda-Count Method is: \>\"", ",", 
         RowBox[{
          RowBox[{"cand", "[", 
           RowBox[{"[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"points", ",", 
               RowBox[{"Max", "[", "points", "]"}]}], "]"}], "]"}], "]"}], 
           "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], ",", 
      RowBox[{"Darker", "[", "Green", "]"}], ",", "Bold"}], "]"}]}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Plurality", " ", "with", " ", "Elimination", " ", "Method"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PluralityWithElimination", "[", 
     RowBox[{"cands_", ",", "vts_", ",", "pref_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"activeCands", "=", "cands"}], ",", 
        RowBox[{"voterProfiles", "=", 
         RowBox[{"Transpose", "[", "pref", "]"}]}], ",", "firstVotes", ",", 
        "minVotes", ",", "elimCands", ",", 
        RowBox[{"majority", "=", 
         RowBox[{
          RowBox[{"Total", "[", "vts", "]"}], "/", "2.0"}]}], ",", 
        RowBox[{"winner", "=", "Null"}], ",", 
        RowBox[{"round", "=", "1"}], ",", "roundTable"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<\\n\\n\\n\\n\\nPlurality with Elimination \
Method\\n-----------------\>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "activeCands", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"firstVotes", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"vts", "[", 
               RowBox[{"[", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"Position", "[", 
                  RowBox[{
                   RowBox[{"voterProfiles", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "c"}], 
                  "]"}], "]"}], "]"}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"c", ",", "activeCands"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Round \>\"", ",", "round", ",", 
            "\"\< first-place vote counts:\>\""}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"roundTable", "=", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"activeCands", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"firstVotes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "activeCands", "]"}]}], "}"}]}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Candidate\>\"", ",", "\"\<Votes\>\""}], "}"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"Grid", "[", 
            RowBox[{"roundTable", ",", 
             RowBox[{"Dividers", "->", 
              RowBox[{"{", 
               RowBox[{"None", ",", 
                RowBox[{"{", 
                 RowBox[{"False", ",", "True", ",", "False"}], "}"}]}], 
               "}"}]}]}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", "firstVotes", "]"}], ">", "majority"}], ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<\\nMajority achieved in Round \>\"", ",", "round", ",", 
               "\"\<!\>\""}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"winner", "=", 
              RowBox[{"activeCands", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"Position", "[", 
                  RowBox[{"firstVotes", ",", 
                   RowBox[{"Max", "[", "firstVotes", "]"}]}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"minVotes", "=", 
           RowBox[{"Min", "[", "firstVotes", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"elimCands", "=", 
           RowBox[{"activeCands", "[", 
            RowBox[{"[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Position", "[", 
               RowBox[{"firstVotes", ",", "minVotes"}], "]"}], "]"}], "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<\\nEliminating (fewest votes = \>\"", ",", "minVotes", ",", 
            "\"\<): \>\"", ",", "elimCands", ",", "\"\<\\n\>\""}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"activeCands", "=", 
           RowBox[{"Complement", "[", 
            RowBox[{"activeCands", ",", "elimCands"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"voterProfiles", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"DeleteCases", "[", 
               RowBox[{"#", ",", 
                RowBox[{"Alternatives", "@@", "elimCands"}]}], "]"}], "&"}], 
             ",", "voterProfiles"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"round", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\\n\>\"", ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
             "\"\<Hence winner by Plurality with Elimination Method is: \>\"",
               ",", "winner"}], "}"}], "]"}], ",", 
           RowBox[{"Darker", "[", "Green", "]"}], ",", "Bold"}], "]"}]}], 
        "]"}], ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}],
    ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PluralityWithElimination", "[", 
   RowBox[{"cand", ",", "votes", ",", "preferance"}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Pairwise", " ", "Comparison", " ", "Method"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PairwiseComparison", "[", 
     RowBox[{"cands_", ",", "vts_", ",", "pref_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "voterProfiles", ",", "numCands", ",", "numVoterGroups", ",", "wins", 
        ",", "losses", ",", "c1", ",", "c2", ",", "rank1", ",", "rank2", ",", 
        "p1Votes", ",", "p2Votes", ",", "maxWins", ",", "winners", ",", 
        "summaryTable"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"voterProfiles", "=", 
        RowBox[{"Transpose", "[", "pref", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"numCands", "=", 
        RowBox[{"Length", "[", "cands", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"numVoterGroups", "=", 
        RowBox[{"Length", "[", "vts", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wins", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numCands", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"losses", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numCands", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", 
        "\"\<\\n\\n\\n\\n\\nPairwise Comparison Method\\n-------------\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"c1", "=", 
           RowBox[{"cands", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"c2", "=", 
           RowBox[{"cands", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"p1Votes", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"p2Votes", "=", "0"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"rank1", "=", 
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{"Position", "[", 
                 RowBox[{
                  RowBox[{"voterProfiles", "[", 
                   RowBox[{"[", "v", "]"}], "]"}], ",", "c1"}], "]"}], "]"}], 
               "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"rank2", "=", 
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{"Position", "[", 
                 RowBox[{
                  RowBox[{"voterProfiles", "[", 
                   RowBox[{"[", "v", "]"}], "]"}], ",", "c2"}], "]"}], "]"}], 
               "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"rank1", "<", "rank2"}], ",", 
               RowBox[{"p1Votes", "+=", 
                RowBox[{"vts", "[", 
                 RowBox[{"[", "v", "]"}], "]"}]}], ",", 
               RowBox[{"p2Votes", "+=", 
                RowBox[{"vts", "[", 
                 RowBox[{"[", "v", "]"}], "]"}]}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"v", ",", "1", ",", "numVoterGroups"}], "}"}]}], " ", 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"p1Votes", ">", "p2Votes"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"wins", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+=", "1"}], ";", 
             RowBox[{
              RowBox[{"losses", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "+=", "1"}]}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"p2Votes", ">", "p1Votes"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"wins", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "+=", "1"}], ";", 
               RowBox[{
                RowBox[{"losses", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "+=", "1"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"wins", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "+=", 
                RowBox[{"1", "/", "2"}]}], ";", 
               RowBox[{
                RowBox[{"wins", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "+=", 
                RowBox[{"1", "/", "2"}]}]}]}], " ", 
             RowBox[{"(*", 
              RowBox[{"0.5", " ", "wins", " ", "for", " ", "a", " ", "tie"}], 
              "*)"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"numCands", "-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"i", "+", "1"}], ",", "numCands"}], "}"}]}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"summaryTable", "=", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"cands", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"wins", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"losses", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "numCands"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Candidate\>\"", ",", "\"\<Wins\>\"", ",", "\"\<Losses\>\""}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<Pairwise win/loss summary:\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Grid", "[", 
         RowBox[{"summaryTable", ",", 
          RowBox[{"Dividers", "->", 
           RowBox[{"{", 
            RowBox[{"None", ",", 
             RowBox[{"{", 
              RowBox[{"False", ",", "True", ",", "False"}], "}"}]}], 
            "}"}]}]}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxWins", "=", 
